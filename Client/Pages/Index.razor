@page "/"
@inject AppData appData
@inject IJSRuntime JsRuntime

<PageTitle>Keys/Access - University of Virginia Facilities Management - Customer Portal</PageTitle>

<div class="container">
    <div id="linkBoxes">
        <p>
            @appData.CompID The key request form has changed and is accessible below. If you have any questions please see the Key Request Overview training document on the <a href="https://www.fm.virginia.edu/services/lock.html" target="_blank">Lock Shop site</a> or contact the Customer Support Center.
        </p>
        <div class="heading-left">
            <h1 class="orange-line-right">Keys/Electronic Access</h1>
        </div>
        <div class="icon-cards">
            <div class="icon-card">
                <a href="residential">
                    <div class="icon-card-inner">
                        <div class="icon-card-image-container">
                            <div class="icon-card-image icon-recycle-bin">
                                <span class="fa-duotone fa-solid fa-house-circle-check" style="--fa-primary-color: #232d4b; --fa-secondary-color: #009ddb; --fa-secondary-opacity: 1;"></span>
                            </div>
                        </div>
                        <div class="icon-card-copy">
                            <h2 class="icon-card-title">
                                Residential lockout/<br>
                                lost key
                            </h2>
                        </div>
                    </div>
                </a>
            </div>

            <div class="icon-card">
                <a href="https://customerportal.fm.virginia.edu/keyrequest/requestor">
                    <div class="icon-card-inner">
                        <div class="icon-card-image-container">
                            <div class="icon-card-image icon-list-check">
                                <span class="fa-duotone fa-solid fa-key" style="--fa-primary-color: #232d4b; --fa-secondary-color: #009ddb; --fa-secondary-opacity: 1;"></span>
                            </div>
                        </div>
                        <div class="icon-card-copy">
                            <h2 class="icon-card-title">Key requests</h2>
                            <p class="icon-card-description">Order keys, transfer keys, request rekey, etc.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="icon-card">
                <a href="https://customerportal.fm.virginia.edu/keyrequest/keyreview/1">
                    <div class="icon-card-inner">
                        <div class="icon-card-image-container">
                            <div class="icon-card-image icon-list-check">
                                <span class="fa-duotone fa-solid fa-clipboard-list-check" style="--fa-primary-color: #009ddb; --fa-secondary-color:  #232d4b; --fa-secondary-opacity: 1;"></span>
                            </div>
                        </div>
                        <div class="icon-card-copy">
                            <h2 class="icon-card-title">Review key requests</h2>
                            <p class="icon-card-description">View, update, print your key requests, etc.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="icon-card">
                <a href="non-residential">
                    <div class="icon-card-inner">
                        <div class="icon-card-image-container">
                            <div class="icon-card-image icon-list-eye">
                                <span class="fa-duotone fa-solid fa-house-circle-xmark" style="--fa-primary-color: #232d4b; --fa-secondary-color: #009ddb; --fa-secondary-opacity: 1;"></span>
                            </div>
                        </div>
                        <div class="icon-card-copy">
                            <h2 class="icon-card-title">
                                Non-residential lockout/<br>
                                lost key
                            </h2>
                            <p class="icon-card-description">Office lockouts, etc.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="icon-card">
                <a href="https://customerportal.fm.virginia.edu/Customerrequest/request/report">
                    <div class="icon-card-inner">
                        <div class="icon-card-image-container">
                            <div class="icon-card-image icon-recycle-green">
                                <span class="fa-duotone fa-solid fa-lock-keyhole-open" style="--fa-primary-color: #232d4b; --fa-secondary-color: #009ddb; --fa-secondary-opacity: 1;"></span>
                            </div>
                        </div>
                        <div class="icon-card-copy">
                            <h2 class="icon-card-title">Non-door keys</h2>
                            <p class="icon-card-description">Filing cabinets, desks, mail boxes, padlocks, etc.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="icon-card">
                <a href="https://customerportal.fm.virginia.edu/customerrequest/request/electronicaccess">
                    <div class="icon-card-inner">
                        <div class="icon-card-image-container">
                            <div class="icon-card-image icon-list-check">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                                    <span class="fa-duotone fa-solid fa-scanner-keyboard" style="--fa-primary-color: #232d4b; --fa-secondary-color: #009ddb; --fa-secondary-opacity: 1;"></span>
                                </svg>
                            </div>
                        </div>
                        <div class="icon-card-copy">
                            <h2 class="icon-card-title">Access control hardware</h2>
                            <p class="icon-card-description">Estimate for installation of new electronic access</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="icon-card">
                <a href="https://idoffice.virginia.edu/mobile-id-wallet">
                    <div class="icon-card-inner">
                        <div class="icon-card-image-container">
                            <div class="icon-card-image icon-list-check">
                                <img src="/home/images/layout/uva-rotunda-logo_blue.png" alt="Graphic llustration of UVA Rotunda in University Blue">
                            </div>
                        </div>
                        <div class="icon-card-copy">
                            <h2 class="icon-card-title">Cavalier Card Office</h2>
                            <p class="icon-card-description">ID information and contact details</p>
                        </div>
                    </div>
                </a>
            </div>

        </div>
    </div>
</div>

@code {

