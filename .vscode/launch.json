{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Node Functions",
            "type": "node",
            "request": "attach",
            "restart": true,
            "port": 9229,
            "preLaunchTask": "func: host start"
        },
        {
            "name": "Blazor WASM Debug",
            "type": "blazorwasm",
            "request": "launch",
            "url": "http://localhost:7192",
            "browser": "edge"
        },
        {
            "name": "C#: Blazor Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/KeyRequest.csproj"
        }
    ]
}